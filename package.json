{
  "name": "tasker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tasker": "dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
